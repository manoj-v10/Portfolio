# Normalize text to LF in the repository; let Git handle the working copy.
* text=auto eol=lf

# Binary assets must never be line-ending converted — CRLF injection
# corrupts PDF xref offsets and font/image byte streams on checkout.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
